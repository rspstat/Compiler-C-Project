%{
#include <stdio.h>
#include "compiler.h" // Generated by Bison/Yacc
#include <string.h>

// Helper function to store string literals and identifiers
// In a real compiler, you'd have a more robust string table
char string_buf[1024];
char *string_ptr = string_buf;

void yyerror(const char *s);
int yylex(void);

// For string literals, copy and store them.
// For identifiers, yylval.sval will point to a copy.
%}

%option noyywrap
%option yylineno

%%
"int"           { return T_INT; }
"char"          { return T_CHAR; }
"void"          { return T_VOID; }
"if"            { return T_IF; }
"else"          { return T_ELSE; }
"while"         { return T_WHILE; }
"for"           { return T_FOR; }
"do"            { return T_DO; }
"switch"        { return T_SWITCH; }
"case"          { return T_CASE; }
"default"       { return T_DEFAULT; }
"break"         { return T_BREAK; }
"continue"      { return T_CONTINUE; }
"return"        { return T_RETURN; }
"print"         { /* Special simple print function */ return T_PRINT; }
"printf"        { return T_PRINTF; }
"scanf"         { return T_SCANF; }


[a-zA-Z_][a-zA-Z0-9_]* {
    yylval.sval = strdup(yytext);
    return T_IDENTIFIER;
}

[0-9]+ {
    yylval.ival = atoi(yytext);
    return T_INTEGER_CONSTANT;
}

L?'(\\.|[^\\'])+' { /* Character constant, e.g., 'a', '\n' */
    if (yytext[0] == 'L' && yytext[1] == '\'') { // Wide char, treat as int for simplicity
        if (yytext[2] == '\\') { // Escape sequence
            switch (yytext[3]) {
                case 'n': yylval.ival = '\n'; break;
                case 't': yylval.ival = '\t'; break;
                case '0': yylval.ival = '\0'; break;
                // Add more escapes if needed
                default: yylval.ival = yytext[3]; break;
            }
        } else {
            yylval.ival = yytext[2];
        }
    } else if (yytext[0] == '\'') {
         if (yytext[1] == '\\') { // Escape sequence
            switch (yytext[2]) {
                case 'n': yylval.ival = '\n'; break;
                case 't': yylval.ival = '\t'; break;
                case '0': yylval.ival = '\0'; break;
                // Add more escapes if needed
                default: yylval.ival = yytext[2]; break;
            }
        } else {
            yylval.ival = yytext[1];
        }
    }
    return T_CHARACTER_CONSTANT;
}


L?\"(\\.|[^\\"])*\" { /* String literal, e.g., "hello", L"wide string" */
    // Remove leading L if present, and quotes
    char *start = yytext;
    if (yytext[0] == 'L') start++;
    start++; // Skip opening quote
    
    // Copy string content, processing escape sequences
    char temp_str[1024];
    int i = 0, j = 0;
    while (start[i] != '\"' && start[i] != '\0') {
        if (start[i] == '\\') {
            i++;
            switch (start[i]) {
                case 'n': temp_str[j++] = '\n'; break;
                case 't': temp_str[j++] = '\t'; break;
                case '\"': temp_str[j++] = '\"'; break;
                case '\\': temp_str[j++] = '\\'; break;
                // Add more escapes as needed
                default: temp_str[j++] = start[i]; break;
            }
        } else {
            temp_str[j++] = start[i];
        }
        i++;
    }
    temp_str[j] = '\0';
    yylval.sval = strdup(temp_str);
    return T_STRING_LITERAL;
}


"+"             { return '+'; }
"-"             { return '-'; }
"*"             { return '*'; }
"/"             { return '/'; }
"%"             { return '%'; }
"="             { return '='; }
"+="            { return T_ADD_ASSIGN; }
"-="            { return T_SUB_ASSIGN; }
"*="            { return T_MUL_ASSIGN; }
"/="            { return T_DIV_ASSIGN; }
"%="            { return T_MOD_ASSIGN; } // Added for completeness
"++"            { return T_INC; }
"--"            { return T_DEC; }
"=="            { return T_EQ; }
"!="            { return T_NE; }
"<"             { return '<'; }
">"             { return '>'; }
"<="            { return T_LE; }
">="            { return T_GE; }
"&&"            { return T_AND; }
"||"            { return T_OR; }
"!"             { return '!'; }
"&"             { return '&'; }
"|"             { return '|'; }
"^"             { return '^'; }
"~"             { return '~'; }
"<<"            { return T_LSHIFT; }
">>"            { return T_RSHIFT; }
"?"             { return '?'; }
":"             { return ':'; }

";"             { return ';'; }
","             { return ','; }
"("             { return '('; }
")"             { return ')'; }
"{"             { return '{'; }
"}"             { return '}'; }
"["             { return '['; }
"]"             { return ']'; }

"//".* { /* Single-line comment, ignore */ }
"/*"            { char c;
                  while(1) {
                      c = input();
                      if (c == EOF) break;
                      if (c == '*') {
                          c = input();
                          if (c == EOF) break;
                          if (c == '/') break;
                          unput(c);
                      }
                  }
                } /* Multi-line comment, ignore */

[ \t\n\r]+      { /* Ignore whitespace */ }

.               { fprintf(stderr, "Lexical error: Unknown character '%s' on line %d\n", yytext, yylineno); }

%%
// Code section for lexer (if any specific helper functions for lexer needed)
// We don't need yywrap if %option noyywrap is used.