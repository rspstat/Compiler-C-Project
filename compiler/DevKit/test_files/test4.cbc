/* 재귀 함수 · 정렬 · 소수 판별 등 고급 기능 테스트 */

/* 피보나치 재귀 */
int fibonacci(int n) {
    if (n <= 1) return n;
    return fibonacci(n - 1) + fibonacci(n - 2);
}

/* 팩토리얼 재귀 */
int factorial(int n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}

/* 최대공약수(유클리드) */
int gcd(int a, int b) {
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

/* 소수 판별 */
int isPrime(int n) {
    if (n <= 1) return 0;
    if (n <= 3) return 1;
    if (n % 2 == 0 || n % 3 == 0) return 0;
    int i = 5;
    while (i * i <= n) {
        if (n % i == 0 || n % (i + 2) == 0) return 0;
        i += 6;
    }
    return 1;
}

/* 버블 정렬 */
void bubbleSort(int arr[], int n) {
    int i, j, tmp;
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
        }
    }
}

int main() {
    int i;

    /* 피보나치 0~9 */
    print(-1);
    for (i = 0; i < 10; i++) {
        print(fibonacci(i));
    }

    /* 팩토리얼 1~7 */
    print(-2);
    for (i = 1; i <= 7; i++) {
        print(factorial(i));
    }

    /* GCD 테스트 */
    print(-3);
    print(gcd(48, 18));   /* 6 */
    print(gcd(17, 13));   /* 1 */
    print(gcd(100, 25));  /* 25 */

    /* 1~20 소수 출력 */
    print(-4);
    for (i = 1; i <= 20; i++) {
        if (isPrime(i)) print(i);
    }

    /* 배열 정렬 */
    int arr[8] = {64,34,25,12,22,11,90,5};
    print(-6);           /* 정렬 전 */
    for (i = 0; i < 8; i++) print(arr[i]);

    bubbleSort(arr, 8);

    print(-7);           /* 정렬 후 */
    for (i = 0; i < 8; i++) print(arr[i]);

    /* 1~100 혼합 합산 */
    int sum = 0;
    for (i = 1; i <= 100; i++) {
        if (i % 2 == 0) sum += i;
        else sum -= i;
    }
    print(sum);          /* -50 */

    return 0;
}
