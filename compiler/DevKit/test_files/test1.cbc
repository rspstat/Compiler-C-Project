/* 기본 산술 연산과 변수·복합 대입·증감 연산 테스트 */

int main() {
    int a, b, c;

    /* 초기 대입 */
    a = 10;
    b = 20;
    c = a + b;

    print(a);   /* 10 */
    print(b);   /* 20 */
    print(c);   /* 30 */

    /* 복합 대입 */
    a += 5;     /* a = 15 */
    b -= 3;     /* b = 17 */
    c *= 2;     /* c = 60 */

    print(a);   /* 15 */
    print(b);   /* 17 */a/* Basic test program for mini C compiler */

int x = 10;
int y = 20;
int result;

int add(int a, int b) {
    return a + b;
}

int main() {
    printf("Basic Calculator Test\n");
    
    result = add(x, y);
    printf("Result of %d + %d = %d\n", x, y, result);
    
    // Test arithmetic operations
    int mul = x * y;
    printf("Multiplication: %d * %d = %d\n", x, y, mul);
    
    int div = y / x;
    printf("Division: %d / %d = %d\n", y, x, div);
    
    // Test conditional
    if (result > 25) {
        printf("Result is greater than 25\n");
    } else {
        printf("Result is not greater than 25\n");
    }
    
    // Test loop
    int i;
    printf("Counting from 1 to 5:\n");
    for (i = 1; i <= 5; i++) {
        printf("Count: %d\n", i);
    }
    
    return 0;
}
    print(c);   /* 60 */

    /* 증감 연산 */
    a++;        /* 16 */
    b--;        /* 16 */
    ++c;        /* 61 */
    --a;        /* 다시 15 */

    print(a);   /* 15 */
    print(b);   /* 16 */
    print(c);   /* 61 */

    return 0;
}
