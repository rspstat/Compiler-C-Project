/* switch-case · 배열 입력 · 거듭제곱 · 복잡 반복문 · 중첩 for 테스트 */

int power(int base, int exp) {
    int r = 1, i;
    for (i = 0; i < exp; i++) r *= base;
    return r;
}

int main() {
    int choice = 1;      /* 메뉴 선택 (시뮬레이션) */
    int num1, num2, res;

    /* 계산기 시뮬레이션: switch */
    print(999);
    switch (choice) {
        case 1:
            num1 = 15; num2 = 25;
            res = num1 + num2;
            print(1001); print(res);    /* 40 */
            break;
        case 2:
            num1 = 30; num2 = 12;
            res = num1 - num2;
            print(1002); print(res);
            break;
        case 3:
            num1 = 7; num2 = 8;
            res = num1 * num2;
            print(1003); print(res);
            break;
        case 4:
            num1 = 84; num2 = 7;
            if (num2 != 0) {
                res = num1 / num2;
                print(1004); print(res);
            } else {
                print(-999);
            }
            break;
        default:
            print(-1);
            break;
    }

    /* 배열 입력 · 최대/최소/합계/평균 */
    int nums[5] = {3,7,1,9,5};
    int i, max = nums[0], min = nums[0], sum = 0;
    print(2001);
    for (i = 0; i < 5; i++) {
        int v = nums[i];
        print(v);
        if (v > max) max = v;
        if (v < min) min = v;
        sum += v;
    }
    print(2002); print(max);
    print(2003); print(min);
    print(2004); print(sum);
    print(2005); print(sum / 5);

    /* 거듭제곱 출력 */
    print(3000);
    for (i = 1; i <= 5; i++) {
        print(power(2, i));   /* 2¹~2⁵ */
    }

    /* 복잡 반복문: break/continue 조합 */
    print(4000);
    for (i = 1; i <= 20; i++) {
        if (i % 3 == 0 && i % 5 == 0) { print(i); continue; }
        if (i > 15) break;
        if (i % 2 == 0) continue;
        if (!(i % 3 == 0 || i % 5 == 0)) print(i);
    }

    /* 중첩 루프 */
    print(5000);
    int row, col;
    for (row = 1; row <= 3; row++) {
        for (col = 1; col <= 3; col++) {
            print(row * 10 + col);
        }
    }

    return 0;
}
