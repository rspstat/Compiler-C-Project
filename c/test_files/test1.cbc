/* 기본 산술 연산과 변수·복합 대입·증감 연산 테스트 */

int main() {
    int a, b, c;

    /* 초기 대입 */
    a = 10;
    b = 20;
    c = a + b;

    print(a);   /* 10 */
    print(b);   /* 20 */
    print(c);   /* 30 */

    /* 복합 대입 */
    a += 5;     /* a = 15 */
    b -= 3;     /* b = 17 */
    c *= 2;     /* c = 60 */

    print(a);   /* 15 */
    print(b);   /* 17 */
    print(c);   /* 60 */

    /* 증감 연산 */
    a++;        /* 16 */
    b--;        /* 16 */
    ++c;        /* 61 */
    --a;        /* 다시 15 */

    print(a);   /* 15 */
    print(b);   /* 16 */
    print(c);   /* 61 */

    return 0;
}
