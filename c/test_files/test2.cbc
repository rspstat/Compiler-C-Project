/* if / while / for / do-while 및 break·continue 테스트 */

int main() {
    int i, sum, n;
    n = 10;
    sum = 0;

    /* if-else */
    if (n > 5) {
        print(1);
    } else {
        print(0);
    }

    /* while: 1~n 합계 */
    i = 1;
    while (i <= n) {
        sum += i;
        i++;
    }
    print(sum);        /* 55 */

    /* for: 5! 계산 */
    int factorial = 1;
    for (i = 1; i <= 5; i++) {
        factorial *= i;
    }
    print(factorial);  /* 120 */

    /* 중첩 if */
    int x = 15;
    if (x > 10) {
        if (x < 20) {
            print(2);
        } else {
            print(3);
        }
    } else {
        print(4);
    }

    /* do-while 예시 */
    int count = 0;
    do {
        count++;
        print(count);
    } while (count < 3);   /* 1,2,3 */

    return 0;
}
