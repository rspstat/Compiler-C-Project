main()
{
    수학점수 = 85;
    영어점수 = 90;
    과학점수 = 78;
    총점 = 0;
    평균 = 0;
    등급 = 0;
    
    총점 = 수학점수 + 영어점수 + 과학점수;
    평균 = 총점 / 3;
    
    if (평균 >= 90) {
        등급 = 1;
    } else {
        if (평균 >= 80) {
            등급 = 2;
        } else {
            if (평균 >= 70) {
                등급 = 3;
            } else {
                등급 = 4;
            }
        }
    }
}