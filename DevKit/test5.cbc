int 피보나치계산(int n)
{
    if (n <= 1) {
        return n;
    } else {
        return 피보나치계산(n-1) + 피보나치계산(n-2);
    }
}

main()
{
    입력값 = 8;
    결과값 = 피보나치계산(입력값);
    
    배열크기 = 10;
    for (i = 0; i < 배열크기; i++) {
        임시값 = 피보나치계산(i);
        if (임시값 > 20) {
            break;
        }
    }
    
    최종결과 = 결과값 * 2;
}